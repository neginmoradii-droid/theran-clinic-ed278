---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Consentimiento Informado Facial — THERAN Clinic">
  <section class="consent-section">
    <div class="consent-card">
      <p class="eyebrow">Documentación clínica</p>
      <h1>Consentimiento Informado<br>Tratamiento Facial</h1>
      <p class="subtexto">Por favor, lee y firma el documento antes de tu cita en THERAN Clinic.</p>
      <div class="form-wrap">
        <iframe
          title="CI-Facial-Theran-Clinic"
          src="https://www.jotform.com/sign/262363864619063/invite/01m0wnejezfbaa4dee70448a6b?signEmbed=1"
          style="height:700px; width:100%; border:0; border-radius:4px;"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  .consent-section {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 120px 24px 60px;
    background: #f8f6f3;
  }
  .consent-card {
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 2px 40px rgba(0,0,0,0.07);
    padding: 48px 40px;
    max-width: 540px;
    width: 100%;
    text-align: center;
  }
  .eyebrow {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #999;
    margin: 0 0 14px;
  }
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    color: #1a1a1a;
    margin: 0 0 14px;
  }
  .subtexto {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    color: #888;
    line-height: 1.7;
    margin: 0 0 32px;
  }
  .form-wrap {
    width: 100%;
    overflow: hidden;
  }
  @media (max-width: 540px) {
    .consent-card { padding: 40px 16px; }
    h1 { font-size: 22px; }
  }
</style>
